-            if ((browser.ie && browser.ie_version <= 11 || browser.ios && view.composing) &&
+            // iOS dictation can keep inserting into a native paragraph after
+            // delivering its creation. Replacing that DIV here loses later
+            // batches. Only the composer opts in; keep the upstream IME path.
+            if (browser.ios && view.constructor.IOS_PARAGRAPH_SYNC === true && !view.composing &&
+                mutations.some(m => m.type == "childList" && m.target == view.contentDOM &&
+                    Array.from(m.addedNodes).some(node => node.nodeName == "DIV"))) {
+                this.iosParagraphPending = true;
+                this.flushSoon();
+            }
+            else if ((browser.ie && browser.ie_version <= 11 || browser.ios && view.composing) &&
                 mutations.some(m => m.type == "childList" && m.removedNodes.length ||
                     m.type == "characterData" && m.oldValue.length > m.target.nodeValue.length))
                 this.flushSoon();
@@ -7447,6 +7461,7 @@ class DOMObserver {
         return this.queue;
     }
     processRecords() {
+        this.iosParagraphPending = false;
         let records = this.pendingRecords();
         if (records.length)
             this.queue = [];
@@ -7857,6 +7872,13 @@
 class EditorView {
+    // OpenChamber's explicit read/lifecycle boundary for the opted-in iOS
